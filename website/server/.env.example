# Copy to server/.env and fill in. Never commit the real file.
NODE_ENV=development
PORT=4000

# MongoDB connection string. "memory" starts a throwaway in-process database (development only).
MONGODB_URI=mongodb://127.0.0.1:27027/arizen

# Long random string (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
SESSION_HOURS=8

# Public address of the website (used for canonical URLs, sitemap and email links).
SITE_URL=http://localhost:5174
# Only needed if the API is called from a different origin than the website.
CORS_ORIGINS=
# Number of trusted reverse proxies in front of the server (1 behind Nginx).
TRUST_PROXY=0

UPLOAD_DIR=
MAX_UPLOAD_MB=10
INQUIRY_RATE_LIMIT=8
LOGIN_RATE_LIMIT=10

# Outgoing email for inquiry notifications. Without SMTP_HOST, emails are logged, not sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Arizen Polymers Website <no-reply@example.com>
# Extra recipients in addition to those set in the dashboard (comma-separated).
NOTIFY_EMAILS=

# First administrator, created by `npm run seed` only if no administrator exists.
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

LOG_LEVEL=info
