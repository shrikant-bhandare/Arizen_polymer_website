# Dependencies
node_modules/

# Build output (rebuilt with `npm run release` / `npm run build`)
dist/
*.tsbuildinfo

# Secrets and local environment: never commit real credentials
.env
.env.*
!.env.example

# Runtime data (uploaded media lives on the server and in backups)
website/server/uploads/

# Generated test, audit and render output
check-output/
website/e2e-output/
website/test-results/
website/scripts/.hero/
lighthouse-*.json

# Logs
*.log
npm-debug.log*

# OS and editor files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Local Claude Code settings (.claude/launch.json is shared)
.claude/settings.local.json

# Design-checker cache (regenerated on every run)
.impeccable/hook.cache.json
